[
 {
  "id": "M2#8960",
  "en": "a really good cup of coffee.",
  "note": "completes #8959 'For you, I'd even brew'"
 },
 {
  "id": "M2#8961",
  "en": "Nicole, are you ready?"
 },
 {
  "id": "M2#8962",
  "en": "Yes",
  "note": "followed by #152 '...'"
 },
 {
  "id": "M2#8963",
  "en": "Um... I... this sort of thing..."
 },
 {
  "id": "M2#8964",
  "en": "This sort of thing... what of it?"
 },
 {
  "id": "M2#8965",
  "en": "This sort of thing",
  "note": "followed by #265 x3 with pauses -> '...'"
 },
 {
  "id": "M2#8966",
  "en": "I feel like I've been waiting for it, "
 },
 {
  "id": "M2#8967",
  "en": "all along."
 },
 {
  "id": "M2#8968",
  "en": "It's embarrassing, isn't it..."
 },
 {
  "id": "M2#8969",
  "en": "There is no need to be ashamed."
 },
 {
  "id": "M2#8970",
  "en": "Everyone comes to feel that way."
 },
 {
  "id": "M2#8971",
  "en": "Now, come into my arms."
 },
 {
  "id": "M2#8972",
  "en": "And "
 },
 {
  "id": "M2#8973",
  "en": "become my",
  "note": "pause after it; msg 345645 #8974 'servant.' completes the sentence"
 },
 {
  "id": "M2#8974",
  "en": "servant."
 },
 {
  "id": "M2#8975",
  "en": "Eek!"
 },
 {
  "id": "M2#8976",
  "en": "Foolish..."
 },
 {
  "id": "M2#8977",
  "en": "She fell into my hands far too easily.",
  "note": "subject restored: Nicole"
 },
 {
  "id": "M2#8978",
  "en": "Humans are such"
 },
 {
  "id": "M2#8979",
  "en": "fools..."
 },
 {
  "id": "M2#8980",
  "en": "Ah, good mor",
  "note": "cut off; followed by #152 '...'; msg 345710 #8981 finishes the word"
 },
 {
  "id": "M2#8981",
  "en": "ning",
  "note": "followed by #152 '...'"
 },
 {
  "id": "M2#8982",
  "en": "(Wow, she went dashing off"
 },
 {
  "id": "M2#8983",
  "en": "at full speed.)"
 },
 {
  "id": "M2#8984",
  "en": "Mornings call for lots of energy",
  "note": "followed by #122 '!'"
 },
 {
  "id": "M2#8985",
  "en": "It's a lovely morning, isn't it?"
 },
 {
  "id": "M2#8986",
  "en": "And I got to see "
 },
 {
  "id": "M2#8987",
  "en": " too!",
  "note": "after the name"
 },
 {
  "id": "M2#8988",
  "en": "Today's sure to be a great day."
 },
 {
  "id": "M2#8989",
  "en": "Ah, good evening."
 },
 {
  "id": "M2#8990",
  "en": "You always greet people so cheerfully."
 },
 {
  "id": "M2#8991",
  "en": "Being cheerful is my only strong point."
 },
 {
  "id": "M2#8992",
  "en": "Um, I'm ",
  "note": "before the name; #473 '.' after it"
 },
 {
  "id": "M2#8993",
  "en": "I've only just moved here."
 },
 {
  "id": "M2#8994",
  "en": "So I came to introduce myself today."
 },
 {
  "id": "M2#8995",
  "en": "next door, so please come by sometime.",
  "note": "continues #8897 'I work as a waitress at the café'"
 },
 {
  "id": "M2#8996",
  "en": "Yes, thank you."
 },
 {
  "id": "M2#8997",
  "en": "you seem busy with your work.",
  "note": "lowercase after '{NAME},' (#6239), as #8904"
 },
 {
  "id": "M2#8998",
  "en": "Keep up the good work!"
 },
 {
  "id": "M2#8999",
  "en": "What is it?"
 },
 {
  "id": "M2#9000",
  "en": "You know, I love the sound of Big Ben."
 },
 {
  "id": "M2#9001",
  "en": "that's what it sounds like it's saying.",
  "note": "continues #8909 in lowercase"
 },
 {
  "id": "M2#9002",
  "en": "That's just my own fancy, though."
 },
 {
  "id": "M2#9003",
  "en": "Big Ben's chimes",
  "note": "followed by #152 '...'"
 },
 {
  "id": "M2#9004",
  "en": "They really do sound lovely, don't they?"
 },
 {
  "id": "M2#9005",
  "en": "What do you have?"
 },
 {
  "id": "M2#9006",
  "en": "That's awfully honest of you."
 },
 {
  "id": "M2#9007",
  "en": "Then I think I'll have tea."
 },
 {
  "id": "M2#9008",
  "en": "Oh, wait a moment."
 },
 {
  "id": "M2#9009",
  "en": "I see. I'm ",
  "note": "before the name; #863 '.' after it"
 },
 {
  "id": "M2#9010",
  "en": "I'll be coming by a lot. Nice to meet you."
 },
 {
  "id": "M2#9011",
  "en": "You came after all!"
 },
 {
  "id": "M2#9012",
  "en": "Is that so?"
 },
 {
  "id": "M2#9013",
  "en": "Um... did I get your bill wrong?"
 },
 {
  "id": "M2#9014",
  "en": "It's all right, don't be so flustered."
 },
 {
  "id": "M2#9015",
  "en": "Yes, I'm sorry."
 },
 {
  "id": "M2#9016",
  "en": "My hometown, you see...",
  "note": "ends a sentence: #8944 'In spring, it just reeks of lambs!' follows"
 },
 {
  "id": "M2#9017",
  "en": "Because I have that to miss,",
  "note": "as #8948; #8949 follows"
 },
 {
  "id": "M2#9018",
  "en": "I wonder why people don't get that."
 },
 {
  "id": "M2#9019",
  "en": "Tea again today, right?"
 },
 {
  "id": "M2#9020",
  "en": "Please, guide me..."
 },
 {
  "id": "M2#9021",
  "en": "I am Janis."
 },
 {
  "id": "M2#9022",
  "en": "Do you have some business with me?"
 },
 {
  "id": "M2#9023",
  "en": "No, I was merely curious where a lovely lady"
 },
 {
  "id": "M2#9024",
  "en": "might be going, you see..."
 },
 {
  "id": "M2#9025",
  "en": "My, that sort of transparent flattery",
  "note": "no punctuation: #9026 'is not to my liking.' / #9115 continue it"
 },
 {
  "id": "M2#9026",
  "en": "is not to my liking.",
  "note": "continues #9025 or #9072 (slice 113)"
 },
 {
  "id": "M2#9027",
  "en": "Aren't you out to flatter me and swindle"
 },
 {
  "id": "M2#9028",
  "en": "me out of my money and jewels?"
 },
 {
  "id": "M2#9029",
  "en": "Heaven forbid."
 },
 {
  "id": "M2#9030",
  "en": "I have no such intention whatsoever, madam."
 },
 {
  "id": "M2#9031",
  "en": "I wonder about that."
 },
 {
  "id": "M2#9032",
  "en": "If you have no business with me, I'll be going."
 },
 {
  "id": "M2#9033",
  "en": "Home is simply stifling..."
 },
 {
  "id": "M2#9034",
  "en": "Going out is such a relief."
 },
 {
  "id": "M2#9035",
  "en": "Oh, my head aches..."
 },
 {
  "id": "M2#9036",
  "en": "Perhaps I drank too much last night."
 },
 {
  "id": "M2#9037",
  "en": "No, I was merely curious where a lovely lady",
  "note": "same as #9023"
 },
 {
  "id": "M2#9038",
  "en": "Aren't you out to flatter me, find where I live,"
 },
 {
  "id": "M2#9039",
  "en": "and then rob us of our valuables?",
  "note": "continues #9038 or #9052 (slice 113)"
 }
]
