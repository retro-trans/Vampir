  "en": "Sorry, rooms are all booked up right now."
 },
 {
  "id": "M2#3666",
  "en": "Business is good, it seems."
 },
 {
  "id": "M2#3667",
  "en": "Sorry 'bout that, come again, eh."
 },
 {
  "id": "M2#3668",
  "en": "Much obliged."
 },
 {
  "id": "M2#3669",
  "en": "Ah, can't wait to knock back"
 },
 {
  "id": "M2#3670",
