[
 {
  "id": "M2#9120",
  "en": "Well then, I'll be going."
 },
 {
  "id": "M2#9121",
  "en": "No, um..."
 },
 {
  "id": "M2#9122",
  "en": "I wondered where on earth this lovely lady"
 },
 {
  "id": "M2#9123",
  "en": "could be going home to."
 },
 {
  "id": "M2#9124",
  "en": "My, following people around,"
 },
 {
  "id": "M2#9125",
  "en": "that's not a nice habit."
 },
 {
  "id": "M2#9126",
  "en": "I-I'm sorry."
 },
 {
  "id": "M2#9127",
  "en": "Hee hee, well, never mind."
 },
 {
  "id": "M2#9128",
  "en": "You're cute, sonny, so I'll forgive you."
 },
 {
  "id": "M2#9129",
  "en": "Following people around"
 },
 {
  "id": "M2#9130",
  "en": "is not a nice habit."
 },
 {
  "id": "M2#9131",
  "en": "Don't follow me anymore."
 },
 {
  "id": "M2#9132",
  "en": "Surely you have a home to go back to too?"
 },
 {
  "id": "M2#9133",
  "en": "Oh, listen to me. Not really, I'm only joking."
 },
 {
  "id": "M2#9134",
  "en": "I couldn't make someone as young as you"
 },
 {
  "id": "M2#9135",
  "en": "do a thing like that, after all."
 },
 {
  "id": "M2#9136",
  "en": "Is there something you want, sonny?"
 },
 {
  "id": "M2#9137",
  "en": "My. Such transparent lies"
 },
 {
  "id": "M2#9138",
  "en": "you'd better stop telling."
 },
 {
  "id": "M2#9139",
  "en": "No, it's true."
 },
 {
  "id": "M2#9140",
  "en": "Hee hee. I wonder."
 },
 {
  "id": "M2#9141",
  "en": "Go home, sonny..."
 },
 {
  "id": "M2#9142",
  "en": "There's nothing fun for you here."
 },
 {
  "id": "M2#9143",
  "en": "Please."
 },
 {
  "id": "M2#9144",
  "en": "keep it a secret.",
  "note": "Lowercase: follows #9056 (slice 113) 'About my going out drinking,'."
 },
 {
  "id": "M2#9145",
  "en": "My, how unusual. A pretty young"
 },
 {
  "id": "M2#9146",
  "en": "boy like you in a place like this."
 },
 {
  "id": "M2#9147",
  "en": "I'm Janis..."
 },
 {
  "id": "M2#9148",
  "en": "Have a drink to our acquaintance, madam."
 },
 {
  "id": "M2#9149",
  "en": "Oh, thank you."
 },
 {
  "id": "M2#9150",
  "en": "Janis,"
 },
 {
  "id": "M2#9151",
  "en": "to think I'd meet you here again."
 },
 {
  "id": "M2#9152",
  "en": "Here, a drink to our acquaintance."
 },
 {
  "id": "M2#9153",
  "en": "Oh, it's that lovely boy from the other day..."
 },
 {
  "id": "M2#9154",
  "en": "Today the drinks are on me."
 },
 {
  "id": "M2#9155",
  "en": "Madam, why not cut back a little?"
 },
 {
  "id": "M2#9156",
  "en": "Hic. Wh-what?"
 },
 {
  "id": "M2#9157",
  "en": "Don't get cheeky with your elders."
 },
 {
  "id": "M2#9158",
  "en": "You'd only been worried about me,",
  "note": "Same as #9089 (slice 113); #9090 'after all.' follows."
 },
 {
  "id": "M2#9159",
  "en": "Today I'll tell you my drunken story."
 },
 {
  "id": "M2#9160",
  "en": "drinking and carrying on, you see.",
  "note": "Follows #9104 (slice 113) 'And so, every day, here I am,'."
 },
 {
  "id": "M2#9161",
  "en": "So that's how it is..."
 },
 {
  "id": "M2#9162",
  "en": "You're lonely, aren't you."
 },
 {
  "id": "M2#9163",
  "en": "And you drink to take your mind off it..."
 },
 {
  "id": "M2#9164",
  "en": "You... ",
  "note": "Before name + #2287 '! ': 'You... {NAME}!'."
 },
 {
  "id": "M2#9165",
  "en": "Why are you here?"
 },
 {
  "id": "M2#9166",
  "en": "I wanted to comfort a lonely lady."
 },
 {
  "id": "M2#9167",
  "en": "Oh my..."
 },
 {
  "id": "M2#9168",
  "en": "But you mustn't come to a place like this."
 },
 {
  "id": "M2#9169",
  "en": "What if my husband wakes up?"
 },
 {
  "id": "M2#9170",
  "en": "It's all right."
 },
 {
  "id": "M2#9171",
  "en": "He's sound asleep now."
 },
 {
  "id": "M2#9172",
  "en": "He won't wake up.",
  "note": "Subject restored: the husband."
 },
 {
  "id": "M2#9173",
  "en": "So that your loneliness might fade a little,"
 },
 {
  "id": "M2#9174",
  "en": "let me kiss you..."
 },
 {
  "id": "M2#9175",
  "en": "Ah...!"
 },
 {
  "id": "M2#9176",
  "en": "Aaaah..."
 },
 {
  "id": "M2#9177",
  "en": "From tonight, you are no longer alone."
 },
 {
  "id": "M2#9178",
  "en": ", you and no other"
 },
 {
  "id": "M2#9179",
  "en": "are my master."
 },
 {
  "id": "M2#9180",
  "en": "What are your orders today?"
 },
 {
  "id": "M2#9181",
  "en": "Every day I'm stuck humoring the Baron's whims,"
 },
 {
  "id": "M2#9182",
  "en": "so I can never rest up. Ugh, I'm so sleepy."
 },
 {
  "id": "M2#9183",
  "en": ", my master, whatever you wish,",
  "note": "After the name."
 },
 {
  "id": "M2#9184",
  "en": "just say the word."
 },
 {
  "id": "M2#9185",
  "en": "This morning I woke up with bloody hands!"
 },
 {
  "id": "M2#9186",
  "en": "Is this the spooky thing everyone's talking about?"
 },
 {
  "id": "M2#9187",
  "en": "Good day, young lady."
 },
 {
  "id": "M2#9188",
  "en": "Oh, yes, hello, good morning!"
 },
 {
  "id": "M2#9189",
  "en": "Can I help you?"
 },
 {
  "id": "M2#9190",
  "en": "I'm busy!"
 },
 {
  "id": "M2#9191",
  "en": "My, my. Where are you off to in such a hurry?"
 },
 {
  "id": "M2#9192",
  "en": "To work!"
 },
 {
  "id": "M2#9193",
  "en": "Ever heard of the \"Eccentric Baron\"?"
 },
 {
  "id": "M2#9194",
  "en": "I work for that very Lord Marvin"
 },
 {
  "id": "M2#9195",
  "en": "as his cook!"
 },
 {
  "id": "M2#9196",
  "en": "Oh no, I'll get scolded if I'm late!"
 },
 {
  "id": "M2#9197",
  "en": "If I'm late, who knows what silly punishment"
 },
 {
  "id": "M2#9198",
  "en": "he'll give me...",
  "note": "Subject 'he' = the Baron (male, glossary)."
 },
 {
  "id": "M2#9199",
  "en": "Sorry, I'm out of time. Bye!"
 }
]
