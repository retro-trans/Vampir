 },
 {
  "id": "M2#9732",
  "en": "'Cause you're nice."
 },
 {
  "id": "M2#9733",
  "en": "...See you, big brother."
 },
 {
  "id": "M2#9734",
  "en": "He glares at Pauline with really scary eyes."
 },
 {
  "id": "M2#9735",
  "en": "You must have been really scared."
 },
 {
  "id": "M2#9736",
  "en": "Poor thing."
 },
 {
  "id": "M2#9737",
